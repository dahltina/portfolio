---
import type { ProjectLink } from '../types/projects';
interface Props { projects: ProjectLink[]; preview?: boolean }
const { projects, preview = false } = Astro.props;
---
<ul class={preview ? 'project-items' : 'more-projects'}>
  {projects.map(project => (
    <a href={project.href} class={preview ? undefined : 'link'}
      onpointerenter={preview ? 'showImage(event)' : undefined}
      onpointerleave={preview ? 'hideImage()' : undefined}>
      <li>
        <span class="fs-2">{project.title}</span>
        <span class="fs-2">{project.category}</span>
      </li>
      {preview && project.image && <img class="image-container" {...project.image} />}
    </a>
  ))}
</ul>
