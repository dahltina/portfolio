---
import ProjectMedia from './ProjectMedia.astro';
import type { ProjectMedia as Media, GalleryLayout } from '../types/projects';
interface Props { images: Media[]; layout?: GalleryLayout }
const { images, layout = 'grid' } = Astro.props;
const uniform = ['square', 'portrait', 'specimen'].includes(layout);
---
<div class:list={['gallery', `gallery--${layout}`, { 'gallery--uniform': uniform }]}>
  {images.map(media => (
    <figure class:list={['gallery__item', { 'gallery__item--panel': !!media.background, 'gallery__item--video': media.type === 'video' && !media.autoplay }]}
      style={media.background ? `background-color: ${media.background}` : undefined}>
      <ProjectMedia media={media} />
      {media.type === 'video' && !media.autoplay && <figcaption class="fs-1">{media.alt}</figcaption>}
    </figure>
  ))}
</div>
