---
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
// Only the home page contains the projects anchor.
const projectsHref = home ? '#projects' : 'index.html#projects';
---
<header class={home ? 'index' : undefined}>
  <a href="index.html">
    <h4 class="fs-2 logo link">Tina Dahl</h4>
  </a>
  <nav>
    <ul>
      <li><a class="fs-2 link" href={projectsHref}>Projects</a></li>
      <li><a class="fs-2 link" href="mailto:post@tinadahl.no">Contact</a></li>
      <li><a class="fs-2 link" href="about.html">About</a></li>
    </ul>
  </nav>
  <slot />
</header>
