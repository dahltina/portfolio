---
interface Props {
  images: string[];
  alt: string;
  width?: number;
  height?: number;
}
const { images, alt, width, height } = Astro.props;
---
<div class="image-slideshow" role="img" aria-label={alt}>
  {images.map((src, index) => (
    <img class="image-slideshow__frame" src={src} alt="" aria-hidden="true" width={width} height={height} style={`--frame-delay: ${index}s`} />
  ))}
</div>
