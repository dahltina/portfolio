---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import projects from '../data/projects.json';
---
<ProjectLayout project={projects["nt-pomaire"]}>
  <br/>
  <p class="fs-1">
    BT Pomaire is a modern sans serif display font.
  </p>
  <br/>
  <p class="fs-1 margin-bottom">
    I intended to create a versatile font that has different use cases and expressions in uppercase and lowercase letters.
    The uppercase letters have a more elegant expression while the lowercase letters have a monotype inspired look.
  </p>
  <div class="fs-3 margin-bottom-small">
    <a class="link link-regular" target="_blank" href="https://github.com/dahltina/project-exam-2-dahltina">Shop</a>
  </div>
</ProjectLayout>
