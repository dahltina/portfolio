---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectList from '../components/ProjectList.astro';
import { featuredProjects, projectLink } from '../data/projects';
const projects = featuredProjects.map(projectLink);
---
<BaseLayout
  title="Tina Dahl | Designer and frontend developer"
  description="Designer and frontend developer based in Oslo"
  home
>
  <Fragment slot="header">
    <div class="hero">
      <h1 class="h1-animated">
        Hey! I'm Tina, a designer and frontend developer based in Oslo.
      </h1>
    </div>
    <SocialLinks class="icons-desktop" />
  </Fragment>
  <main>

    <!------ projects ------>

    <div class="project-list">
      <h2 id="projects" class="fs-5 margin-bottom">PROJECTS</h2>
      <ProjectList projects={projects} preview />
    </div>

  </main>
</BaseLayout>
