---
import BaseLayout from './BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectList from '../components/ProjectList.astro';
import projects from '../data/projects.json';

interface Props {
  project: (typeof projects)[keyof typeof projects];
}
const { project } = Astro.props;
---
<BaseLayout
  title={project.title}
  description={project.description}
  bodyClass="body-project"
>
  <main class="project-page">
    <SocialLinks class="icons-desktop" />
    <img {...project.image} />
    <div class="project">
      {project.year ? (
        <div class="title-container margin-bottom-small">
          <h1 class={project.headingClass}>{project.heading}</h1>
          <p>{project.year}</p>
        </div>
      ) : <h1 class={project.headingClass}>{project.heading}</h1>}
      <div class="project-container">
        <div class="project-description margin-bottom">
          <slot />
        </div>
      </div>
    </div>
    <h2 class="fs-4 margin-bottom">MORE PROJECTS</h2>
    <div class="margin-bottom">
      <ProjectList projects={project.related} />
    </div>
  </main>
</BaseLayout>
